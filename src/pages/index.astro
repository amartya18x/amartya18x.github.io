---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { getCollection, getEntry } from 'astro:content';
import { publications, topics } from '../lib/publications';

const posts = await getCollection('posts');
const talks = posts.filter((entry) => {
  const categories = Array.isArray(entry.data.categories) ? entry.data.categories : [entry.data.categories];
  return categories.includes('talk') && entry.data.date instanceof Date && !Number.isNaN(entry.data.date.valueOf());
}).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
// Keep a stable archive: talks remain visible between static-site builds.
const recentTalks = talks.slice(0, 4);
const archivedTalks = talks.slice(4);
const homeNews = await getEntry('news', 'home');
const newsItems = (homeNews?.data.items ?? []).filter((item) => item.showOnHome !== false)
  .sort((a, b) => b.date.valueOf() - a.date.valueOf() || (b.sort ?? 0) - (a.sort ?? 0));
const recentPublications = publications.slice(0, 6);
const publicationYears = [...new Set(publications.map((entry) => entry.year))].sort((a, b) => Number(b) - Number(a));
const formatDate = (date, day = false) => new Intl.DateTimeFormat('en-US', { month: 'short', ...(day ? { day: 'numeric' } : {}), year: 'numeric', timeZone: 'UTC' }).format(date);
---
<BaseLayout title="Amartya Sanyal" description="Amartya Sanyal, Assistant Professor in Machine Learning at the University of Copenhagen. Research on privacy, unlearning, robustness, fairness, and learning theory.">
  <nav class="site-nav" aria-label="Sections">
    <a href="#about">About</a><a href="#group">Group</a><a href="#news">News</a><a href="#publications">Publications</a><a href="#talks">Talks</a><a href="#teaching">Teaching</a><a href="#service">Funding &amp; Service</a>
  </nav>
  <section class="hero" id="top">
    <div>
      <h1>Amartya Sanyal</h1>
      <p class="hero__tagline">
        Assistant Professor in Machine Learning · University of Copenhagen; Adjunct Assistant Professor at IIT Kanpur
      </p>
      <p class="hero__tagline">
        <a href="https://cope-forml.github.io/">FoRML: Foundations of Responsible Machine Learning</a>
      </p>
      <div class="hero__actions">
        <a class="pill" target="_blank" href="mailto:amartya18x@gmail.com">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 6h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2zm0 2 8 5 8-5" />
          </svg>
          Email
        </a>
